#!/bin/bash
# Скрипт для настройки VLAN-коммутатора на базе ALT Linux (etcnet)
# HQ-SW: бридж br0 с VLAN filtering

set -e  # остановка при ошибке

# --- Настройки (при необходимости измените имена интерфейсов) ---
UPLINK="enp0s8"      # порт, смотрящий на HQ-RTR (trunk)
ACCESS_VLAN100="enp0s9"
ACCESS_VLAN200="enp0s10"
VLAN100=100
VLAN200=200
BRIDGE="br0"

echo "=== Настройка VLAN-коммутатора на HQ-SW ==="

# 1. Останавливаем сетевую службу, чтобы изменения применились чисто
systemctl stop network

# 2. Создаём директории ifaces
mkdir -p /etc/net/ifaces/{$UPLINK,$ACCESS_VLAN100,$ACCESS_VLAN200,$BRIDGE}

# 3. Настраиваем физические порты (они будут членами бриджа)
# Для каждого порта пишем TYPE=eth, ONBOOT=yes и указываем BRIDGE
for iface in $UPLINK $ACCESS_VLAN100 $ACCESS_VLAN200; do
    cat > /etc/net/ifaces/$iface/options <<EOF
TYPE=eth
ONBOOT=yes
BRIDGE=$BRIDGE
EOF
done

# 4. Настраиваем бридж br0: включаем vlan_filtering, явно перечисляем порты (опционально)
cat > /etc/net/ifaces/$BRIDGE/options <<EOF
TYPE=bridge
ONBOOT=yes
BRIDGE_OPTS="vlan_filtering=1"
BRIDGE_PORTS="$UPLINK $ACCESS_VLAN100 $ACCESS_VLAN200"
EOF

# 5. Создаём post-up скрипт для настройки VLAN-правил на бридже
POSTUP_DIR="/etc/net/ifaces/$BRIDGE/up.d"
mkdir -p $POSTUP_DIR
cat > $POSTUP_DIR/50-vlan-config <<'EOF'
#!/bin/bash
# Этот скрипт выполняется после поднятия бриджа br0
# Настраивает PVID для access-портов и разрешённые VLAN на транке

UPLINK="enp0s8"
ACCESS_VLAN100="enp0s9"
ACCESS_VLAN200="enp0s10"
VLAN100=100
VLAN200=200
BRIDGE="br0"

# Ожидаем появления бриджа (максимум 5 секунд)
for i in {1..10}; do
    ip link show $BRIDGE >/dev/null 2>&1 && break
    sleep 0.5
done

# Удаляем стандартное разрешение VLAN 1 (необязательно, но повышает чистоту)
bridge vlan del dev $BRIDGE vid 1 self 2>/dev/null || true

# Настраиваем access-порты: PVID + untagged
bridge vlan add dev $ACCESS_VLAN100 vid $VLAN100 pvid untagged
bridge vlan add dev $ACCESS_VLAN200 vid $VLAN200 pvid untagged

# Настраиваем транк (uplink): разрешаем только нужные VLAN, без PVID
bridge vlan add dev $UPLINK vid $VLAN100
bridge vlan add dev $UPLINK vid $VLAN200

# Убираем VLAN 1 с транка, если не нужен (осторожно – может отрезать управление!)
bridge vlan del dev $UPLINK vid 1 2>/dev/null || true

echo "VLAN-конфигурация на бридже $BRIDGE применена"
EOF

chmod +x $POSTUP_DIR/50-vlan-config

# 6. Запускаем сеть заново
systemctl start network

echo "=== Настройка завершена ==="
echo "Проверка состояния:"
bridge vlan show
echo ""
echo "Если всё прошло успешно, порты настроены:"
echo "  $UPLINK  – trunk (VLAN $VLAN100, $VLAN200)"
echo "  $ACCESS_VLAN100 – access VLAN $VLAN100"
echo "  $ACCESS_VLAN200 – access VLAN $VLAN200"
